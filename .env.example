# ─── APP ──────────────────────────────────────────────
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1

# ─── JWT ──────────────────────────────────────────────
JWT_SECRET=change_me_in_production_very_long_secret_key
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=30d

# ─── DATABASE ─────────────────────────────────────────
DATABASE_URL=postgresql://signal:signal_password@localhost:5432/signal_urbain?schema=public

# ─── REDIS ────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── MINIO (S3-compatible) ────────────────────────────
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=signal_minio
MINIO_SECRET_KEY=signal_minio_secret
MINIO_BUCKET=signal-photos
MINIO_USE_SSL=false

# ─── SMS OTP (Twilio ou Moov/Togocel) ────────────────
SMS_PROVIDER=twilio          # twilio | moov | togocel | console (dev)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxx
TWILIO_FROM_NUMBER=+1234567890

# ─── FIREBASE (push notifications) ───────────────────
FIREBASE_PROJECT_ID=signal-urbain
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@signal-urbain.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ─── CORS ─────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://localhost:3001

# ─── RATE LIMITING ───────────────────────────────────
THROTTLE_TTL=60000
THROTTLE_LIMIT=100
OTP_MAX_PER_HOUR=5
