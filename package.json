{
  "name": "signal-urbain",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@9.4.0",
  "scripts": {
    "dev:api": "pnpm --filter @signal/api dev",
    "dev:dashboard": "pnpm --filter @signal/dashboard dev",
    "dev:mobile": "pnpm --filter @signal/mobile start",
    "build": "pnpm -r build",
    "lint": "eslint . --ext .ts,.tsx",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "format": "prettier --write \"**/*.{ts,tsx,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,json,md,yml,yaml}\"",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "docker:up": "docker-compose -f docker-compose.dev.yml up -d",
    "docker:down": "docker-compose -f docker-compose.dev.yml down",
    "docker:logs": "docker-compose -f docker-compose.dev.yml logs -f",
    "db:migrate": "pnpm --filter @signal/api prisma migrate dev",
    "db:studio": "pnpm --filter @signal/api prisma studio",
    "db:seed": "pnpm --filter @signal/api prisma db seed"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^7.5.0",
    "@typescript-eslint/parser": "^7.5.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "jest": "^29.7.0",
    "prettier": "^3.2.5",
    "ts-jest": "^29.1.2",
    "typescript": "^5.4.2"
  }
}
