{
  "expo": {
    "name": "Signal Urbain Togo",
    "slug": "signal-togo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "signaltogo",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#1A472A"
    },
    "plugins": [
      "expo-router",
      "expo-location",
      "expo-image-picker",
      "expo-camera",
      "expo-notifications",
      "expo-secure-store"
    ],
    "newArchEnabled": false,
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1A472A"
      },
      "softwareKeyboardLayoutMode": "resize",
      "package": "tg.signalurbain.app",
      "permissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "tg.signalurbain.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Signal Urbain Togo utilise votre position pour localiser l'incident.",
        "NSCameraUsageDescription": "Prenez une photo de l'incident pour votre signalement.",
        "NSPhotoLibraryUsageDescription": "Sélectionnez une photo de l'incident depuis votre galerie."
      }
    },
    "extra": {
      "apiUrl": "https://signal-urbain.onrender.com/api/v1",
      "router": {},
      "eas": {
        "projectId": "4e6ca37c-d722-46de-8909-8c699a479c32"
      }
    },
    "owner": "opscorporation",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/4e6ca37c-d722-46de-8909-8c699a479c32"
    }
  }
}
